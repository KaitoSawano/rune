#!/bin/bash
#
#  runecashd The runecash core server.
#
#
# chkconfig: 345 80 20
# description: runecashd
# processname: runecashd
#

# Source function library.
. /etc/init.d/functions

# you can override defaults in /etc/sysconfig/runecashd, see below
if [ -f /etc/sysconfig/runecashd ]; then
        . /etc/sysconfig/runecashd
fi

RETVAL=0

prog=runecashd
# you can override the lockfile via RUNECASHD_LOCKFILE in /etc/sysconfig/runecashd
lockfile=${RUNECASHD_LOCKFILE-/var/lock/subsys/runecashd}

# runecashd defaults to /usr/bin/runecashd, override with RUNECASHD_BIN
runecashd=${RUNECASHD_BIN-/usr/bin/runecashd}

# runecashd opts default to -disablewallet, override with RUNECASHD_OPTS
runecashd_opts=${RUNECASHD_OPTS--disablewallet}

start() {
    echo -n $"Starting $prog: "
    daemon $DAEMONOPTS $runecashd $runecashd_opts
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && touch $lockfile
    return $RETVAL
}

stop() {
    echo -n $"Stopping $prog: "
    killproc $prog
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && rm -f $lockfile
    return $RETVAL
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status $prog
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: service $prog {start|stop|status|restart}"
        exit 1
        ;;
esac
